# Browser requests use the canonical backend prefix. Keep this same-origin in production.
VITE_API_BASE_URL="/api/v1"

# Local Vite development proxy target. This value is never exposed to browser code.
VITE_API_PROXY_TARGET="http://127.0.0.1:8000"

# Demo personas and simulator controls are disabled unless explicitly enabled.
# For an isolated demo, set both demo and mock flags to true.
VITE_DEMO_MODE="false"

# Local mock records are disabled unless explicit demo mode is also enabled.
VITE_USE_MOCK_API="false"
