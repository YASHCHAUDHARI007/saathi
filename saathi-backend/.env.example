# ==========================================
# SAATHI Backend Environment Variables
# ==========================================

SECRET_KEY=saathi-super-secret-dev-key-change-in-production-2026-poa-secure
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,localhost:3000,localhost:8000

# Database Configuration (PostgreSQL / SQLite fallback for development)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=saathi_db
DB_USER=saathi_user
DB_PASSWORD=saathi_secure_pass_2026
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AI Pipeline Settings
AI_MODE=mock
AI_CONFIDENCE_THRESHOLD=0.75
CROSS_MODEL_DISAGREEMENT_THRESHOLD=0.35

# Scoring Engine Weights (Total = 1.0)
WEIGHT_TEXT_DISTRESS=0.35
WEIGHT_VOICE_STRESS=0.20
WEIGHT_EMOTION_SIGNAL=0.10
WEIGHT_LONGITUDINAL_TREND=0.15
WEIGHT_BASELINE_DEVIATION=0.10
WEIGHT_ENGAGEMENT_CHANGE=0.10

# Risk Thresholds
RISK_THRESHOLD_LOW_MAX=29
RISK_THRESHOLD_MODERATE_MAX=59
RISK_THRESHOLD_HIGH_MAX=84

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
